      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, bit_clicks_by_browser{job=~\"$job\",instance=~\"$instance\"})",
          "legendFormat": "{{browser}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": [
